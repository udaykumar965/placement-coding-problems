public class Main
{
    public static void main(String[] args)
    {
        int a=9876543;
        int l,p;
        Boolean flag = true;

        while((a/10)!=0)
        {
            l=a%10;
            p=(a/10)%10;
            if (p<l)
            {
                flag = false;
                break;
            }
            a=a/10;
        }

        if (flag)
            System.out.println("Decending order");
        else
            System.out.println("not decending order");
    }
}
